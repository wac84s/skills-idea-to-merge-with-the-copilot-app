<section class="bookmark-manager" aria-labelledby="manager-title">
  <div class="intro">
    <p class="eyebrow">YOUR PERSONAL LINK LIBRARY</p>
    <h2 id="manager-title">Save a little for later.</h2>
    <p class="description">Turn any web address into a tidy, memorable Mona link.</p>
  </div>

  <form id="add-bookmark" novalidate>
    <div class="field">
      <label for="url">Website address</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com/article"
        aria-describedby="url-hint"
      />
    </div>
    <button type="submit">Add bookmark <span aria-hidden="true">↗</span></button>
  </form>

  <p id="url-hint" class="hint">A missing <code>https://</code> is added for you.</p>
  <p id="bookmark-status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">
    <span class="empty-icon" aria-hidden="true">✳</span>
    <strong>Your collection starts here</strong>
    <span>Save a link above and its Mona slug will appear here.</span>
  </p>

  <div id="list-header" class="list-header" hidden>
    <div>
      <p class="eyebrow">BOOKMARKS</p>
      <h3 class="list-title">Your saved links</h3>
    </div>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" class="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import { formatBookmark, loadBookmarks, normalizeUrl } from '../lib/bookmarks.js';

  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('bookmark-status');

  function readBookmarks() {
    try {
      return loadBookmarks(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  let bookmarks = readBookmarks();

  function saveBookmarks() {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
      return true;
    } catch {
      status.textContent = 'Could not save your bookmarks in this browser.';
      return false;
    }
  }

  function renderBookmarks() {
    list.replaceChildren();
    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'copy';
      copy.textContent = 'Copy slug';
      copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          status.textContent = `${bookmark.slug} copied.`;
        } catch {
          status.textContent = 'Could not copy the slug from this browser.';
        }
      });

      item.append(link, separator, slug, copy);
      list.append(item);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      status.textContent = '';
      const url = normalizeUrl(input.value);
      if (!url) {
        status.textContent = 'Enter a valid http or https web address.';
        input.focus();
        return;
      }

      let slug;
      for (let attempt = 0; attempt < 10; attempt += 1) {
        const bytes = crypto.getRandomValues(new Uint8Array(4));
        const alphabet = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
        const candidate = `mona-${Array.from(bytes, (byte) => alphabet[byte % alphabet.length]).join('')}`;
        if (!bookmarks.some((bookmark) => bookmark.slug === candidate)) {
          slug = candidate;
          break;
        }
      }

      if (!slug) {
        status.textContent = 'Could not create a unique slug. Please try again.';
        return;
      }

      bookmarks = [...bookmarks, { url, slug }];
      if (!saveBookmarks()) {
        bookmarks = bookmarks.slice(0, -1);
        return;
      }

      input.value = '';
      status.textContent = `Saved ${formatBookmark({ url, slug })}.`;
      renderBookmarks();
    } catch {
      status.textContent = 'Could not add that bookmark. Please try again.';
    }
  });

  document.getElementById('clear-all')?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      window.localStorage.removeItem(STORAGE_KEY);
      status.textContent = 'All bookmarks cleared.';
    } catch {
      status.textContent = 'Bookmarks were cleared for this page, but browser storage could not be updated.';
    }
    renderBookmarks();
  });

  renderBookmarks();
</script>

